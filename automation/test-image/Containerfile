#
# One Linux test environment: the ubuntu-24.04 runner the Linux CI jobs use, with the toolchains those jobs install,
# taken from the same pins and the same install scripts. automation/test-image/build.sh assembles the build context
# (only the pin files and install scripts below) and passes the versions read from their owners, so this file holds
# no version of its own:
#   GO_VERSION, GO_URL, GO_SHA256   the go row of automation/dev/toolchains.lock (.go-version)
#   NODE_VERSION                    .node-version (checked against nodejs.org's SHASUMS256.txt)
#   RUST_VERSION                    RUST_VERSION in .github/workflows/ci.yml
# SBCL comes from automation/ci/install-sbcl.sh (automation/dev/toolchains.lock), the apt packages from
# automation/ci/install-native-test-packages.sh. npm stays per checkout: automation/ci/install-npm-toolchain.sh installs
# it into the tree at run time, as CI does.
ARG UBUNTU_IMAGE=docker.io/library/ubuntu:24.04@sha256:73b999393d07f2bf65a40373778a44dc9a6d54ad7718d29247d8ff9413c4d6a8
FROM ${UBUNTU_IMAGE}

ARG GO_VERSION
ARG GO_URL
ARG GO_SHA256
ARG NODE_VERSION
ARG RUST_VERSION

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 TZ=Etc/UTC

# The base tools the hosted runner image ships and the install scripts and tests assume: sudo for the apt script, git,
# curl, the archive tools, tzdata, and a Python with venv for the SDK and terminal-engine venvs. tzdata-legacy holds the
# backward zone links (Cuba, US/Eastern, ...): ICU resolves a TZ value through the host's zoneinfo, so without them
# internal/yaml12 TestDateStringMatchesNode sees Node name different zones than CI's runner image, which ships them.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git sudo xz-utils bzip2 unzip zstd file tzdata tzdata-legacy locales \
      python3 python3-venv python3-pip jq less openssh-client procps psmisc lsof \
 && rm -rf /var/lib/apt/lists/*

COPY automation/ /tmp/pig/automation/
COPY .go-version .node-version /tmp/pig/

# Native test packages: the same script and list the Linux CI jobs run. Its libxcb 1.16 build (build-libxcb.sh, for
# ubuntu-24.04's 1.15) goes to a fixed prefix that PKG_CONFIG_PATH below names, as CI's $GITHUB_ENV does.
RUN apt-get update \
 && SUDO= PIG_LIBXCB_PREFIX=/opt/pig-libxcb /tmp/pig/automation/ci/install-native-test-packages.sh \
 && test -f /opt/pig-libxcb/lib/pkgconfig/xcb.pc \
 && rm -rf /var/lib/apt/lists/*

# Go: the official archive of the toolchains.lock row, checked against its digest.
RUN test "go${GO_VERSION}" = "go$(tr -d '\r\n' < /tmp/pig/.go-version)" \
 && curl -fsSL --retry 3 -o /tmp/go.tgz "$GO_URL" \
 && echo "$GO_SHA256  /tmp/go.tgz" | sha256sum -c - \
 && tar -C /usr/local -xzf /tmp/go.tgz && rm /tmp/go.tgz

# Node: the official linux-x64 archive of .node-version, checked against the release's SHASUMS256.txt.
RUN test "$NODE_VERSION" = "$(cat /tmp/pig/.node-version)" \
 && cd /tmp \
 && curl -fsSL --retry 3 -O "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
 && curl -fsSL --retry 3 -O "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" \
 && grep " node-v${NODE_VERSION}-linux-x64.tar.xz\$" SHASUMS256.txt | sha256sum -c - \
 && tar -C /usr/local --strip-components=1 -xJf "node-v${NODE_VERSION}-linux-x64.tar.xz" \
 && rm -f node-v*.tar.xz SHASUMS256.txt

# SBCL: install-sbcl.sh installs and checks the pinned binary.
RUN prefix="$(/tmp/pig/automation/ci/install-sbcl.sh /opt/pig-sbcl | tail -n1)" && test "$prefix" = /opt/pig-sbcl

# The runner user: non-root with passwordless sudo, as on the hosted runner. uid 1000 matches podman's --userns=keep-id
# for a host user 1000, so files written into a mounted checkout keep their owner.
RUN userdel -r ubuntu 2>/dev/null || true \
 && useradd -m -u 1000 -s /bin/bash runner \
 && echo 'runner ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/runner && chmod 0440 /etc/sudoers.d/runner \
 && install -d -m 0700 -o runner -g runner /run/user/1000 \
 && rm -rf /tmp/pig

USER runner
# XDG_RUNTIME_DIR as on the hosted runner: without it the extension host puts its sockets in $TMPDIR/pig-<uid>, which
# test-grouped.sh's leaked-scratch check reports.
ENV HOME=/home/runner \
    XDG_RUNTIME_DIR=/run/user/1000 \
    PIG_SBCL=/opt/pig-sbcl/bin/sbcl \
    SBCL_HOME=/opt/pig-sbcl/lib/sbcl \
    PKG_CONFIG_PATH=/opt/pig-libxcb/lib/pkgconfig \
    PATH=/home/runner/.cargo/bin:/home/runner/go/bin:/usr/local/go/bin:/opt/pig-sbcl/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Rust: rustup with the toolchain and components the Linux jobs install.
RUN curl -fsSL --retry 3 https://sh.rustup.rs -o /tmp/rustup.sh \
 && sh /tmp/rustup.sh -y --no-modify-path --profile minimal --default-toolchain "$RUST_VERSION" --component rustfmt --component clippy \
 && rm /tmp/rustup.sh \
 && test "$(rustc --version | cut -d' ' -f2)" = "$RUST_VERSION"

RUN mkdir -p /home/runner/.cache /home/runner/go /home/runner/.cargo/registry /home/runner/.npm
WORKDIR /home/runner
